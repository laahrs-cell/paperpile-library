@ARTICLE{Kasai2019-iu,
  title    = "Roles of d-Lactate Dehydrogenases in the Anaerobic Growth of
              Shewanella oneidensis {MR}-1 on Sugars",
  author   = "Kasai, Takuya and Suzuki, Yusuke and Kouzuma, Atsushi and
