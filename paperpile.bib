@ARTICLE{Wang2015-qt,
  title    = "Adaptation genomics of a small-colony variant in a Pseudomonas
              chlororaphis 30-84 biofilm",
  author   = "Wang, Dongping and Dorosky, Robert J and Han, Cliff S and Lo,
