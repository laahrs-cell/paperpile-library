@ARTICLE{Tahlan2007-kd,
  title    = "Initiation of actinorhodin export in Streptomyces coelicolor",
  author   = "Tahlan, Kapil and Ahn, Sang Kyun and Sing, Anson and Bodnaruk,
              Tetyana D and Willems, Andrew R and Davidson, Alan R and Nodwell,
              Justin R",
  journal  = "Mol. Microbiol.",
  volume   =  63,
  number   =  4,
  pages    = "951--961",
  abstract = "Many microorganisms produce molecules having antibiotic activity
              and expel them into the environment, presumably enhancing their
              ability to compete with their neighbours. Given that these
              molecules are often toxic to the producer, mechanisms must exist
              to ensure that the assembly of the export apparatus accompanies or
              precedes biosynthesis. Streptomyces coelicolor produces the
              polyketide antibiotic actinorhodin in a multistep pathway
