               nematode. In this review, we consider the application of C.
               elegans to human infectious disease research, as well as consider
               the nematode response to these natural pathogens.",
  month     =  apr,
  year      =  2012,
  language  = "en"
}

@ARTICLE{Yu2006-zl,
