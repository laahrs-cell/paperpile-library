@ARTICLE{Berger2014-rc,
  title     = "Robustness and plasticity of metabolic pathway flux among
               uropathogenic isolates of Pseudomonas aeruginosa",
  author    = "Berger, Antje and Dohnt, Katrin and Tielen, Petra and Jahn,
