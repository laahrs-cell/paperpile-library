@ARTICLE{Grimm2025-st,
  title     = "Pseudomonas aeruginosa {PfpI} is a methylglyoxalase",
  author    = "Grimm, Larson and Wijaya, Andre and Askenasy, Isabel and Nazeer,
               Rahan Rudland and Seki, Hikaru and Brear, Paul D and Figueroa,
