  language  = "en"
}

@ARTICLE{Krishnamoorthy2017-sq,
  title    = "Synergy between Active Efflux and Outer Membrane Diffusion Defines
              Rules of Antibiotic Permeation into Gram-Negative Bacteria",
  author   = "Krishnamoorthy, Ganesh and Leus, Inga V and Weeks, Jon W and
              Wolloscheck, David and Rybenkov, Valentin V and Zgurskaya, Helen I",
  journal  = "MBio",
  volume   =  8,
  number   =  5,
  abstract = "Gram-negative bacteria are notoriously resistant to antibiotics,
              but the extent of the resistance varies broadly between species.
              We report that in significant human pathogens Acinetobacter
              baumannii, Pseudomonas aeruginosa, and Burkholderia spp., the
              differences in antibiotic resistance are largely defined by their
              penetration into the cell. For all tested antibiotics, the
              intracellular penetration was determined by a synergistic
              relationship between active efflux and the permeability barrier.
              We found that the outer membrane (OM) and efflux pumps select
