@ARTICLE{Okegbe2017-cn,
  title    = "Electron-shuttling antibiotics structure bacterial communities by
              modulating cellular levels of c-di-{GMP}",
  author   = "Okegbe, Chinweike and Fields, Blanche L and Cole, Stephanie J and
              Beierschmitt, Christopher and Morgan, Chase J and Price-Whelan,
