@ARTICLE{Jurand1978-bc,
  title     = "Further investigations on the prelethal effects of the killing
               action of kappa containing killer stocks of \textit{Paramecium
               aurelia}",
  author    = "Jurand, A and Preer, Jr, J R and Rudman, B M",
