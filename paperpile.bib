@ARTICLE{Tseng2013-py,
  title    = "The extracellular matrix protects Pseudomonas aeruginosa biofilms
              by limiting the penetration of tobramycin",
  author   = "Tseng, Boo Shan and Zhang, Wei and Harrison, Joe J and Quach, Tam
