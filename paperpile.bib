@ARTICLE{Rajput2020-vo,
  title    = "Pangenome analytics reveal two-component systems as conserved
              targets in {ESKAPEE} pathogens",
  author   = "Rajput, Akanksha and Seif, Yara and Choudhary, Kumari Sonal and
              Dalldorf, Christopher and Poudel, Saugat and Monk, Jonathan and
