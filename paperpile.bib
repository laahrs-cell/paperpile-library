@ARTICLE{Paixao2015-qe,
  title    = "Host glycan sugar-specific pathways in Streptococcus pneumoniae:
              galactose as a key sugar in colonisation and infection [corrected]",
  author   = "Paixão, Laura and Oliveira, Joana and Veríssimo, André and Vinga,
              Susana and Lourenço, Eva C and Ventura, M Rita and Kjos, Morten
