  language = "en"
}

@ARTICLE{Santos2014-jq,
  title    = "Population dynamics of a Salmonella lytic phage and its host:
              implications of the host bacterial growth rate in modelling",
  author   = "Santos, Sílvio B and Carvalho, Carla and Azeredo, Joana and
