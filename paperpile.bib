  author   = "Xing, Jiawei and Gumerov, Vadim M and Zhulin, Igor B",
  journal  = "J. Bacteriol.",
  pages    = "e0030022",
  abstract = "Photoactive yellow protein (PYP) is a model photoreceptor. It
