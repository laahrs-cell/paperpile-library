@ARTICLE{Flynn2016-lo,
  title    = "Evidence and Role for Bacterial Mucin Degradation in Cystic
              Fibrosis Airway Disease",
  author   = "Flynn, Jeffrey M and Niccum, David and Dunitz, Jordan M and
