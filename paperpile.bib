@ARTICLE{Pinchuk2009-up,
  title    = "Genomic reconstruction of \textit{Shewanella oneidensis} {MR}-1
              metabolism reveals a previously uncharacterized machinery for
              lactate utilization",
  author   = "Pinchuk, Grigory E and Rodionov, Dmitry A and Yang, Chen and Li,
              Xiaoqing and Osterman, Andrei L and Dervyn, Etienne and
              Geydebrekht, Oleg V and Reed, Samantha B and Romine, Margaret F
              and Collart, Frank R and Scott, James H and Fredrickson, Jim K and
