@ARTICLE{Mutlu2018-vn,
  title    = "Phenotypic memory in Bacillus subtilis links dormancy entry and
              exit by a spore quantity-quality tradeoff",
  author   = "Mutlu, Alper and Trauth, Stephanie and Ziesack, Marika and Nagler,
