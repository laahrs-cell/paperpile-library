@ARTICLE{Jin2020-jt,
  title    = "Hybrid Model of Bacterial Biofilm Growth",
  author   = "Jin, Xing and Marshall, Jeffrey S and Wargo, Matthew J",
  journal  = "Bull. Math. Biol.",
  volume   =  82,
  number   =  2,
  pages    =  27,
  abstract = "Bacterial biofilms play a critical role in environmental
              processes, water treatment, human health, and food processing.
              They exhibit highly complex dynamics due to the interactions
              between the bacteria and the extracellular polymeric substance
              (EPS), water, and nutrients and minerals that make up the biofilm.
              We present a hybrid computational model in which the dynamics of
              discrete bacterial cells are simulated within a multiphase
              continuum, consisting of EPS and water as separate interacting
