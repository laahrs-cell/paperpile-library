@ARTICLE{James2016-dl,
  title    = "Microsensor and transcriptomic signatures of oxygen depletion in
              biofilms associated with chronic wounds",
  author   = "James, Garth A and Ge Zhao, Alice and Usui, Marcia and Underwood,
              Robert A and Nguyen, Hung and Beyenal, Haluk and deLancey Pulcini,
