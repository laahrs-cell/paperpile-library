@ARTICLE{Takenaka2008-zi,
  title    = "Direct visualization of spatial and temporal patterns of
              antimicrobial action within model oral biofilms",
  author   = "Takenaka, Shoji and Trivedi, Harsh M and Corbin, Audrey and Pitts,
