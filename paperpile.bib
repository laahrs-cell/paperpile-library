@ARTICLE{Arnaouteli2019-ms,
  title    = "Pulcherrimin formation controls growth arrest of the Bacillus
              subtilis biofilm",
  author   = "Arnaouteli, Sofia and Matoz-Fernandez, D A and Porter, Michael and
              Kalamara, Margarita and Abbott, James and MacPhee, Cait E and
