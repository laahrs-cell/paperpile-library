@ARTICLE{Tan2015-fn,
  title    = "Community quorum sensing signalling and quenching: microbial
              granular biofilm assembly",
  author   = "Tan, Chuan Hao and Koh, Kai Shyang and Xie, Chao and Zhang, Joela
