@ARTICLE{Balskus2009-cz,
  title    = "Searching for Small-Molecule-Mediated Extracellular Redox in
              Terrestrial and Marine Microorganisms",
  author   = "Balskus, Emily P",
  journal  = "Woods Hole Report",
  pages    = "1--18",
  abstract = "Small-molecule-mediated extracellular redox shuttling has recently
              been demonstrated to play a role in many interesting bacterial
              processes, including mineral respiration and survival in biofilms.
              In this project, a more general search for extracellular redox
              behavior was undertaken by screening a variety of terrestrial and
              marine isolates for their ability to clear MnO2 from layered agar
              plates. In addition to identifying many strains that exhibited
              clearance behavior, a PCR-based assay was developed to screen for
              the presence of phenazine biosynthetic gene clusters in genomic
              DNA of the isolates. Finally, the extracellular redox behavior of
              prodiginine-producing marine bacterium Vibrio gazogenes was
              explored in more detail. Electrochemical data implicated a Mn(IV)
              ! Mn(II) redox in MnO2 clearance, and the prodiginine natural
              products isolated from this strain were shown to undergo
              reversible oxidation, which may lend support for their proposed
              their involvement in a small-molecule-mediated extracellular redox
              process.",
  year     =  2009
}

