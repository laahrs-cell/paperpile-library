  language = "en"
}

@ARTICLE{Seviour2019-cx,
  title    = "Extracellular polymeric substances of biofilms: Suffering from an
              identity crisis",
  author   = "Seviour, Thomas and Derlon, Nicolas and Dueholm, Morten Simonsen
              and Flemming, Hans-Curt and Girbal-Neuhauser, Elisabeth and Horn,
              Harald and Kjelleberg, Staffan and van Loosdrecht, Mark C M and
              Lotti, Tommaso and Malpei, M Francesca and Nerenberg, Robert and
              Neu, Thomas R and Paul, Etienne and Yu, Hanqing and Lin, Yuemei",
  journal  = "Water Res.",
  volume   =  151,
  pages    = "1--7",
  abstract = "Microbial biofilms can be both cause and cure to a range of
              emerging societal problems including antimicrobial tolerance,
              water sanitation, water scarcity and pollution. The identities of
              extracellular polymeric substances (EPS) responsible for the
              establishment and function of biofilms are poorly understood. The
              lack of information on the chemical and physical identities of EPS
              limits the potential to rationally engineer biofilm processes, and
              impedes progress within the water and wastewater sector towards a
              circular economy and resource recovery. Here, a multidisciplinary
