@ARTICLE{Dueholm2010-fu,
  title    = "Functional amyloid in Pseudomonas",
  author   = "Dueholm, Morten S and Petersen, Steen V and Sønderkær, Mads and
              Larsen, Poul and Christiansen, Gunna and Hein, Kim L and Enghild,
