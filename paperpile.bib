  year     =  2007,
  keywords = "biodiversity evolution macrobes microbes microbiology
              multicellularity ontology prokaryotes taxonomy horizontal
              gene-transfer cell-cell communication bacterial chemotaxis
              microbial ecology genome sequence species concept
              hyperthermophilic archaea streptococcus-pneumoniae prokaryotic
