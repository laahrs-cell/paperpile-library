@ARTICLE{Eiserich2018-kv,
  title    = "Quantitative assessment of cyanide in cystic fibrosis sputum and
              its oxidative catabolism by hypochlorous acid",
  author   = "Eiserich, Jason P and Ott, Sean P and Kadir, Tamara and Morrissey,
