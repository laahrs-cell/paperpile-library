  month    =  mar,
  year     =  2016,
  keywords = "LOV; flavoproteins; optogenetics; photoreceptors",
  language = "en"
}

@ARTICLE{Krauss2009-wy,
  title    = "Distribution and phylogeny of
              light-oxygen-voltage-blue-light-signaling proteins in the three
