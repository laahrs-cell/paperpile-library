@ARTICLE{Reddy2009-si,
  title    = "Structural insights into the mechanism of the allosteric
              transitions of Mycobacterium tuberculosis {cAMP} receptor protein",
  author   = "Reddy, Manchi C M and Palaninathan, Satheesh K and Bruning, John B
