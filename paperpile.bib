@BOOK{Lump2015-bc,
  title    = "A molecular tweezer antagonizes seminal amyloids and {HIV}
              infection",
  author   = "Lump, Edina and Castellano, Laura M and Meier, Christoph and
              Seeliger, Janine and Erwin, Nelli and Sperlich, Benjamin and
              Stürzel, Christina M and Usmani, Shariq and Hammond, Rebecca M and
