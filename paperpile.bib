@ARTICLE{Li2013-fh,
  title    = "{NO}-induced biofilm dispersion in Pseudomonas aeruginosa is
              mediated by an {MHYT} domain-coupled phosphodiesterase",
  author   = "Li, Yi and Heine, Sabrina and Entian, Michael and Sauer, Karin and
