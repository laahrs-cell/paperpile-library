@ARTICLE{Pereira2001-dg,
  title    = "A novel scenario for the evolution of haem-copper oxygen
              reductases",
  author   = "Pereira, M M and Santana, M and Teixeira, M",
  journal  = "Biochim. Biophys. Acta",
  volume   =  1505,
  number   = "2-3",
  pages    = "185--208",
  abstract = "The increasing sequence information on oxygen reductases of the
              haem-copper superfamily, together with the available
              three-dimensional structures, allows a clear identification of
              their common, functionally important features. Taking into
              consideration both the overall amino acid sequences of the core
              subunits and key residues involved in proton transfer, a novel
              hypothesis for the molecular evolution of these enzymes is
              proposed. Three main families of oxygen reductases are identified
              on the basis of common features of the core subunits, constituting
              three lines of evolution: (i) type A (mitochondrial-like
              oxidases), (ii) type B (ba3-like oxidases) and (iii) type C
