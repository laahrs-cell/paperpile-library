}

@ARTICLE{Skaldin2018-iu,
  title     = "Secreted bacterial adenosine deaminase is an evolutionary
               precursor of adenosine deaminase growth factor",
  author    = "Skaldin, Maksym and Tuittila, Minna and Zavialov, Andrey V and
