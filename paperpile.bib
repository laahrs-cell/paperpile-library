}

@ARTICLE{Sushko2021-bq,
  title     = "A new twist of rubredoxin function in {M}. tuberculosis",
  author    = "Sushko, Tatsiana and Kavaleuski, Anton and Grabovec, Irina and
               Kavaleuskaya, Anna and Vakhrameev, Daniil and Bukhdruker, Sergey
               and Marin, Egor and Kuzikov, Alexey and Masamrekh, Rami and
