  month    =  dec,
  year     =  2020,
  language = "en"
}

@ARTICLE{Punchi_Hewage2020-ax,
  title     = "Mobilization of Iron Stored in Bacterioferritin Is Required for
               Metabolic Homeostasis in Pseudomonas aeruginosa",
  author    = "Punchi Hewage, Achala N D and Fontenot, Leo and Guidry, Jessie
