@ARTICLE{Schaefer2008-wd,
  title    = "A new class of homoserine lactone quorum-sensing signals",
  author   = "Schaefer, Amy L and Greenberg, E P and Oliver, Colin M and Oda,
              Yasuhiro and Huang, Jean J and Bittan-Banin, Gili and Peres,
