@ARTICLE{Nielson2022-et,
  title    = "Glyoxylate protects against cyanide toxicity through metabolic
              modulation",
  author   = "Nielson, Jason R and Nath, Anjali K and Doane, Kim P and Shi, Xu
              and Lee, Jangwoen and Tippetts, Emily G and Saha, Kusumika and
              Morningstar, Jordan and Hicks, Kevin G and Chan, Adriano and Zhao,
              Yanbin and Kelly, Amy and Hendry-Hofer, Tara B and Witeof, Alyssa
              and Sips, Patrick Y and Mahon, Sari and Bebarta, Vikhyat S and
