  year     =  1997,
  keywords = "Amino Acid Sequence Bacteria/genetics/*metabolism
              Fungi/genetics/*metabolism Gene Expression Genes, Bacterial Genes,
              Fungal Heme/metabolism Molecular Sequence Data Multigene Family
              Nitric Oxide/metabolism Nitrites/metabolism Nitrogen/*metabolism
              Nitrous Oxide/metabolism Phylogeny",
  language = "en"
}

@ARTICLE{Tabernero2012-dq,
