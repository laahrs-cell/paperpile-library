  keywords = "cis-regulatory motif; enhancer; gene regulation; glucocorticoid;
              palindrome; rhodopsin; steroid hormone receptor; transcription
              factor",
  language = "en"
}

@ARTICLE{Vahvelainen2023-vt,
  title    = "Deletion of competence genes represses expression of genes
              associated with anaerobic respiration/metabolism in
              Aggregatibacter actinomycetemcomitans",
  author   = "Vahvelainen, Nelli and Kovesjoki, Laura and Maula, Terhi and
