  month     =  mar,
  year      =  2026,
  keywords  = "Pseudomonas aeruginosa ; Anti-virulence; Pyoverdine; Quorum
               sensing; Siderophore",
  language  = "en"
}

@ARTICLE{Harrington2026-lt,
