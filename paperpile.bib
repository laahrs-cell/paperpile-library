@ARTICLE{Reese2018-su,
  title    = "Antibiotic-induced changes in the microbiota disrupt redox
              dynamics in the gut",
  author   = "Reese, Aspen T and Cho, Eugenia H and Klitzman, Bruce and Nichols,
