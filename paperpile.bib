@ARTICLE{Bottura2024-uh,
  title     = "Oxygen microenvironments in {E}. coli biofilm nutrient transport
               channels: Insights from complementary sensing approaches",
  author    = "Bottura, Beatrice and McConnell, Gail and Florek, Lindsey C and
               Smiley, Marina K and Martin, Ross and Eana, Ash and Dayton,
