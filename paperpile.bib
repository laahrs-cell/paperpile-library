  language = "en"
}

@ARTICLE{Evans2023-ey,
  title    = "Spatial heterogeneity in biofilm metabolism elicited by local
              control of phenazine methylation",
  author   = "Evans, Christopher R and Smiley, Marina K and Thio, Sean Asahara
              and Wei, Mian and Price-Whelan, Alexa and Min, Wei and Dietrich,
              Lars E P",
  journal  = "bioRxivorg",
  pages    = "2023.02.15.528762",
