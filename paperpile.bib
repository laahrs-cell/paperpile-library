@ARTICLE{Tomita2005-ub,
  title    = "No transcription-translation feedback in circadian rhythm of
              {KaiC} phosphorylation",
  author   = "Tomita, Jun and Nakajima, Masato and Kondo, Takao and Iwasaki,
