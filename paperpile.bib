               has been demonstrated to enhance virus replication through the
               activation of the ROS/HIF-1α pathway, suggesting potential new
               targets for combating the virus.",
  month     =  nov,
  year      =  2024,
  keywords  = "Glycolysis; HIF-1α; Influenza A virus; Lung; Mitochondria; ROS",
  language  = "en"
}

@ARTICLE{Zhang2022-ht,
