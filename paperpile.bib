@ARTICLE{Lim2012-zk,
  title     = "The effect of iron limitation on the transcriptome and proteome
               of Pseudomonas fluorescens Pf-5",
  author    = "Lim, Chee Kent and Hassan, Karl A and Tetu, Sasha G and Loper,
               Joyce E and Paulsen, Ian T",
  journal   = "PLoS One",
  publisher = "Public Library of Science",
  volume    =  7,
  number    =  6,
  pages     = "e39139",
  abstract  = "One of the most important micronutrients for bacterial growth is
               iron, whose bioavailability in soil is limited. Consequently,
               rhizospheric bacteria such as Pseudomonas fluorescens employ a
               range of mechanisms to acquire or compete for iron. We
               investigated the transcriptomic and proteomic effects of iron
