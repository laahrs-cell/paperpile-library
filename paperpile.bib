@ARTICLE{Stanton2024-io,
  title     = "The glycolytic metabolite methylglyoxal covalently inactivates
               the {NLRP3} inflammasome",
  author    = "Stanton, Caroline and Buasakdi, Chavin and Sun, Jie and Levitan,
