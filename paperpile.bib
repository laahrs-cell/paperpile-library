@ARTICLE{Dikiy2019-fo,
  title    = "Insights into histidine kinase activation mechanisms from the
              monomeric blue light sensor {EL346}",
  author   = "Dikiy, Igor and Edupuganti, Uthama R and Abzalimov, Rinat R and
