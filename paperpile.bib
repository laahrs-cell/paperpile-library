  journal   = "ACS Sustainable Chem. Eng.",
  publisher = "American Chemical Society",
  abstract  = "One of the central roles in the design, development, and
               application advances in mediator-based microbial electrochemical
               systems, such as microbial fuel cells (MFCs), is the
