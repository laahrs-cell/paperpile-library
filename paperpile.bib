  language = "en"
}

@ARTICLE{Zhao2016-uv,
  title    = "Modeling antimicrobial tolerance and treatment of heterogeneous
              biofilms",
  author   = "Zhao, Jia and Seeluangsawat, Paisa and Wang, Qi",
