@ARTICLE{Klimova2008-gk,
  title    = "Mitochondrial complex {III} regulates hypoxic activation of {HIF}",
  author   = "Klimova, T and Chandel, N S",
  journal  = "Cell Death Differ.",
  volume   =  15,
  number   =  4,
  pages    = "660--666",
  abstract = "Decreases in oxygen levels are observed in physiological
              processes, such as development, and pathological situations, such
              as tumorigenesis and ischemia. In the complete absence of oxygen
              (anoxia), mammalian cells are unable to generate sufficient energy
              for survival, so a mechanism for sensing a decrease in the oxygen
              level (hypoxia) before it reaches a critical point is crucial for
              the survival of the organism. In response to decreased oxygen
              levels, cells activate the transcription factors hypoxia-inducible
              factors (HIFs), which lead to metabolic adaptation to hypoxia, as
