@INCOLLECTION{Pullan2008-nk,
  title     = "Chapter 25 - Microbial Responses to Nitric Oxide and Nitrosative
               Stress: Growth, “Omic,” and Physiological Methods",
  author    = "Pullan, Steven T and Monk, Claire E and Lee, Lucy and Poole,
