@ARTICLE{Tik2026-at,
  title     = "Chemical Interactions between the Common Soil Bacteria
               Pseudomonas chlororaphis and Bacillus subtilis",
  author    = "Tik, Zohar and Uzi-Gavrilov, Shaked and Hagbi-Lazar, Bat-El and
               Nwobodo, David C and Sivan, Orit and Meijler, Michael M",
  journal   = "ACS Chem. Biol.",
  publisher = "American Chemical Society (ACS)",
  number    = "acschembio.6c00420",
  abstract  = "Chemical signaling between soil inhabitants is of tremendous
               importance to the health of many ecosystems, and at the same time
               detailed molecular knowledge underlying these conversations is
               surprisingly scarce. One of the major bacterial genera inhabiting
               the rhizosphere is Pseudomonas, of which most species are known
               to produce phenazines, which carry antibiotic properties.
               Pseudomonas chlororaphis, a common rhizosphere dwelling species
               with plant growth-promoting traits, produces
               phenazine-1-carboxamide (PCN). This study examines how the
               production of PCN by Pseudomonas affects another common species
               in soil that it often encounters, namely Bacillus subtilis. When
               both species were cultured at close distance, distinct and
               visible changes in colony morphologies were observed without
               changes in growth rates. Interestingly, a clear transformation
               occurred in the morphology of B. subtilis colonies in the
               presence of supplemented PCN, indicating the role of phenazines
               in affecting colony morphology. In addition, untargeted
               metabolomics analyses showed a decrease in the production of
               plipastatin and surfactin by B. subtilis in the presence of P.
               chlororaphis. Our results indicate that PCN induces changes in
               morphology and signaling of B. subtilis without significantly
               affecting its growth. We hypothesize that P. chlororaphis and B.
               subtilis sense one another and act to conserve energy while
               avoiding competition.",
  month     =  jul,
  year      =  2026,
  language  = "en"
}

@ARTICLE{Loncar2026-nb,
  title     = "Bacterial resilience and dispersal in dynamic oxygen gradients",
  author    = "Loncar, Aleksandar and Secchi, Eleonora and Jimenez-Martinez,
               Joaquin and Le Borgne, Tanguy and Tabuteau, Hervé",
  journal   = "Biomicrofluidics",
  publisher = "AIP Publishing",
  volume    =  20,
  number    =  4,
  pages     =  044104,
  abstract  = "Oxygen availability is a key environmental cue that shapes
               bacterial physiology, growth, and surface colonization, yet how
               individual bacteria respond when oxygen landscapes change over
               time remains poorly understood. Microfluidic devices provide
               powerful platforms to generate and control dissolved gas
               gradients at microscopic scales, enabling systematic
               investigations of their effects on biological and chemical
               processes. However, existing systems, utilizing diffusion for
               gradient formation, often limit rapid modulation of dissolved gas
               over a large field of view, constrain possible flow rates, and
               require multilayer fabrication. Here, we developed a
               single-layer, microfluidic platform that enables rapid
               equilibration of dissolved gas concentrations over a large
               chamber width, compared to diffusion-based systems with the same
               width. Using this device, we investigated the response of the
               soil bacterium Pseudomonas putida to dissolved oxygen gradients
               that vary both spatially and temporally. We tracked surface
               colonization by individual cells over periods of up to 7 h. Our
               results reveal how spatiotemporal fluctuations in dissolved
               oxygen shape colony spatial organization, growth rates, and
               single-cell dynamics, including elongation, attachment, and
               detachment dynamics. The experiments show that P. putida
               maintains exponential growth for several generations after an
               oxygen downshift, indicating a buffered response likely supported
               by metabolic memory and internal reserves while low-oxygen
               adaptation unfolds. This delayed physiological shift drives
               spatial reorganization into “settler” and “disperser”
               subpopulations, linking single-cell adaptation to biofilm-scale
               structure.",
  month     =  jul,
  year      =  2026,
  language  = "en"
}

@ARTICLE{Piazza2026-zn,
