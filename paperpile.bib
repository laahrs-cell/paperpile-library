  journal   = "J. Bacteriol.",
  publisher = "American Society for Microbiology",
  abstract  = "ABSTRACT Pseudomonas aeruginosa is an opportunistic human
               pathogen that poses a significant health threat. Many pathogenic
               behaviors of P. aeruginosa are under control of the bacterial
