  journal  = "Eur. J. Biochem.",
  volume   =  268,
  number   =  8,
  pages    = "2486--2497",
  abstract = "In order to study the induction of terminal oxidases in Paracoccus
              denitrificans, their promoters were fused to the lacZ reporter
              gene and analysed in the wild-type strain, in an FnrP-negative
              mutant, in a cytochrome bc1-negative mutant, and in six single or
