  year     =  2022,
  language = "en"
}

@ARTICLE{Fredman2019-yg,
  title    = "The inflamed sputum in lower respiratory tract infection:
              l-lactate levels are correlated to neutrophil accumulation",
  author   = "Fredman, Gabriella and Kolpen, Mette and Hertz, Frederik Boetius
