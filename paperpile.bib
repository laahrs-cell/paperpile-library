@ARTICLE{Tomlinson2021-oh,
  title     = "Staphylococcus aureus induces an itaconate-dominated
               immunometabolic response that drives biofilm formation",
  author    = "Tomlinson, Kira L and Lung, Tania Wong Fok and Dach, Felix and
               Annavajhala, Medini K and Gabryszewski, Stanislaw J and Groves,
