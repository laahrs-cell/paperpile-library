@ARTICLE{Ray2012-sj,
  title    = "Reactive oxygen species ({ROS}) homeostasis and redox regulation
              in cellular signaling",
  author   = "Ray, Paul D and Huang, Bo-Wen and Tsuji, Yoshiaki",
