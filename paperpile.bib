  year     =  2010,
  keywords = "Anti-Bacterial Agents/*pharmacology Biofilms/*drug effects/*growth
              \& development DNA, Bacterial/metabolism Polysaccharides,
              Bacterial/biosynthesis Pseudomonas aeruginosa/drug effects/growth
              \& development/metabolism/*physiology",
  language = "en"
}

@ARTICLE{Gao2012-jx,
