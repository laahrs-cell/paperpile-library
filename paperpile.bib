@ARTICLE{Persat2015-lr,
  title     = "Type {IV} pili mechanochemically regulate virulence factors in
               Pseudomonas aeruginosa",
  author    = "Persat, Alexandre and Inclan, Yuki F and Engel, Joanne N and
