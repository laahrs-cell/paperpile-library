@INPROCEEDINGS{Buckle2015-vt,
  title     = "Pyocyanin secreted by Pseudomonas aeruginosa inhibits growth of
               several {CF}-infecting species but not Burkholderia cenocepacia",
  author    = "Buckle, Edwina and Klare, William and Campos-Atherino, Mariana
               and Das, Theerthankar and Manos, Jim and {others}",
  booktitle = "ResearchGate",
  abstract  = "Pseudomonas aeruginosa as an opportunistic human pathogen infects
               a range of sites including burns, wounds, immunocompromised
               nosocomial patients and cystic fibrosis (CF) sufferers.
               Infections are typically polymicrobial however P. aeruginosa
               generally is, or becomes, the dominant bacterium. We sought to
               assess the inhibitory effects of P. aeruginosa secreted factors
               on other bacteria typically found in polymicrobial association
               with it. P. aeruginosa strains PAO1, UCBPP-PA14 and acute
               (AES-1R) and chronic (AES-1M) isogens of Australian Epidemic
               Strain 1 isolated from the same patient 10.5 years apart and not
               eradicated in the interim, were grown in Luria-Bertani broth (LB)
               with shaking for 16h at 37oC. The LB was then filtered twice to
               remove bacteria, and undiluted and serially diluted 2 ml aliquots
               were inoculated with Staphylococcus aureus (MSSA and MRSA),
               Burkholderia cenocepacia and Escherichia coli and incubated with
               shaking at 37oC for 16-24hrs. The undiluted filtered LB
               (secretome) from PAO1, UCBPP-PA14 and AES-1R completely inhibited
               growth of all species, whereas that of AES-1M did not inhibit any
               species. To identify potential inhibitors, P. aeruginosa
               secretomes were assayed for the secreted redox-active
               antimicrobial pyocyanin, which was present (40μM to 68μM) in all
               except AES-1M; whilst all species except B. cenocepacia grew in
               the secretome of a pyocyanin-deficient mutant (PA14ΔphzA-G).
               Species sensitivity in the presence of purified pyocyanin was
               also assayed (n=3): IC50 for E. coli was 19μM; for both S. aureus
               strains it was 40μM, however for B. cenocepacia IC50 was 180μM,
               and it was able to grow in 300μM pyocyanin. Since B. cenocepacia
               did not grow in the lower pyocyanin levels (<68μM) of the above
               secretomes, we assayed the secreted components of the Type VI
               secretion system (T6SS) in PAO1 and a full T6SS knockout in
               UCBPP-PA14 as potential inhibitors. B. cenocepacia did not grow
               in either secretome, suggesting that B. cenocepacia inhibition by
               P. aeruginosa neither related to pyocyanin or the secreted T6SS
               components. We conclude that whilst pyocyanin is the primary P.
               aeruginosa secreted factor for inhibition of S. aureus and E.
               coli, it does not inhibit B. cenocepacia at physiologically
               secreted levels. The different pyocyanin susceptibilities
               identified here indicate that pyocyanin is not a universal
               bacterial inhibitor.",
  month     =  sep,
  year      =  2015
}

