@ARTICLE{Dela_Cruz2010-ev,
  title    = "Expression of the Streptomyces coelicolor {SoxR} regulon is
              intimately linked with actinorhodin production",
  author   = "Dela Cruz, Rica and Gao, Yang and Penumetcha, Sahitya and
