@ARTICLE{Dunham2026-or,
  title     = "The Guild Model of {CF} airway microbial ecology",
  author    = "Dunham, Sage J B and Willkeen, Gregory A and Darby, Ben and
               Corley, Jodi M and Hahn, Andrea and Klapper, Isaac and Bean,
               Heather D and Caverly, Lindsay J and Thornton, Christina S and
