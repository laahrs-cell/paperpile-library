@ARTICLE{Scribani-Rossi2026-fl,
  title     = "Measuring bacterial oxygen consumption rate to probe metabolic
               signature and antimicrobial susceptibility",
  author    = "Scribani Rossi, Chiara and Angeli, Simone and Casciaro, Bruno and
               Loffredo, Maria Rosa and Mangoni, Maria Luisa and Spizzichino,
