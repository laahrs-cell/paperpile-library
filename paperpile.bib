@ARTICLE{Soh2021-rz,
  title    = "Disruption of the Pseudomonas aeruginosa Tat system perturbs
              {PQS}-dependent quorum sensing and biofilm maturation through lack
              of the Rieske cytochrome {bc1} sub-unit",
  author   = "Soh, Eliza Ye-Chen and Smith, Frances and Gimenez, Maxime Rémi and
              Yang, Liang and Vejborg, Rebecca Munk and Fletcher, Matthew and
              Halliday, Nigel and Bleves, Sophie and Heeb, Stephan and Cámara,
