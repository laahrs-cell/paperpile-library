  language = "en"
}

@ARTICLE{Alberghini2009-vr,
  title    = "Consequences of relative cellular positioning on quorum sensing
              and bacterial cell-to-cell communication",
  author   = "Alberghini, Sara and Polone, Elisa and Corich, Viviana and Carlot,
