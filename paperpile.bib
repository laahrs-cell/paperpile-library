@ARTICLE{Yamagishi2012-on,
  title     = "Trichocyst ribbons of a cryptomonads are constituted of homologs
               of {R}-body proteins produced by the intracellular parasitic
               bacterium of Paramecium",
  author    = "Yamagishi, Takahiro and Kai, Atsushi and Kawai, Hiroshi",
