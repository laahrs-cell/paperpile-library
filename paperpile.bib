@ARTICLE{Zhang2024-kv,
  title     = "Influenza A virus-induced glycolysis facilitates virus
               replication by activating {ROS}/{HIF}-1α pathway",
  author    = "Zhang, Yijia and Chang, Lifeng and Xin, Xin and Qiao, Yixuan and
