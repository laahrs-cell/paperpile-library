  year      =  1943
}

@INCOLLECTION{Sonneborn1959-rq,
  title     = "Kappa and Related Particles in Paramecium",
  author    = "Sonneborn, T M",
  editor    = "Smith, Kenneth M and Lauffer, Max A",
  booktitle = "Advances in Virus Research",
  publisher = "Academic Press",
  volume    =  6,
  pages     = "229--356",
  abstract  = "Publisher Summary This chapter is concerned primarily with the
               particles in Paramecium aurelia and is considered in relation to
               the particles in other organisms. It attempts to integrate as
               fully as possible the results of the various specialized
               approaches to the problems raised by kappa, pi, and mu, placing
               the particles themselves at the center of attention. The possible
               relations of the toxic agent to viruses, colicins, and toxins,
               and the nature of the specific protection against killing action
               are discussed from a comparative point of view, taking into
               account the possible fundamental similarity between kappa and mu
               in spite of their superficial but striking differences. As the
               particles, rather than the paramecia that bear them, are the
               center of attention, the role of kappa and mu as cytoplasmic
               genetic factors of Paramecium is given subordinate consideration.
               The chapter also aims to take a fresh, critical look at the whole
               corpus of knowledge about the particles themselves. This includes
               their morphology, development, actions, quantity, cytochemistry,
               reproduction, transmission, persistence, mutability,
               interrelations with each other and with the rest of paramecium,
               responses to injurious agents, and infectivity. On the basis of
               this survey, the status of the particles and the problems raised
               by them are discussed. A brief account of possibly comparable
               particles in other ciliates and in higher organisms provides the
               ground for speculation as to whether the particle system in
               Paramecium is a special case or an example of a widespread
               phenomenon in nature.",
  month     =  jan,
  year      =  1959
}

@ARTICLE{Sonneborn1938-ly,
