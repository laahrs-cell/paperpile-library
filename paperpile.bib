@ARTICLE{Komitopoulou2004-in,
  title    = "Oxidation-reduction potential regulates {RpoS} levels in
              Salmonella Typhimurium",
  author   = "Komitopoulou, E and Bainton, N J and Adams, M R",
  journal  = "J. Appl. Microbiol.",
  volume   =  96,
