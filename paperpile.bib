  year     =  2009,
  keywords = "Bacteria/chemistry/genetics/metabolism *Bacterial Physiological
              Phenomena Biofilms/*growth \& development Biological Evolution
              Models, Biological",
  language = "en"
}

@ARTICLE{McLoon2011-sf,
