@ARTICLE{Matz2008-pd,
  title    = "Pseudomonas aeruginosa uses type {III} secretion system to kill
              biofilm-associated amoebae",
  author   = "Matz, Carsten and Moreno, Ana Maria and Alhede, Morten and
