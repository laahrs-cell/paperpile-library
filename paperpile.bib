@ARTICLE{Dwyer2014-rq,
  title    = "Antibiotics induce redox-related physiological alterations as part
              of their lethality",
  author   = "Dwyer, Daniel J and Belenky, Peter A and Yang, Jason H and
              MacDonald, I Cody and Martell, Jeffrey D and Takahashi, Noriko and
              Chan, Clement T Y and Lobritz, Michael A and Braff, Dana and
