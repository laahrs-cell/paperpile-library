  language = "en"
}

@ARTICLE{Toner2005-se,
  title    = "Spatially resolved characterization of biogenic manganese oxide
              production within a bacterial biofilm",
  author   = "Toner, Brandy and Fakra, Sirine and Villalobos, Mario and Warwick,
