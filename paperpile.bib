@ARTICLE{Voordeckers2012-de,
  title    = "Identification of a complex genetic network underlying
              Saccharomyces cerevisiae colony morphology",
  author   = "Voordeckers, Karin and De Maeyer, Dries and van der Zande, Elisa
              and Vinces, Marcelo D and Meert, Wim and Cloots, Lore and Ryan,
