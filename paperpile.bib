@ARTICLE{Greub2004-ts,
  title    = "Microorganisms resistant to free-living amoebae",
  author   = "Greub, Gilbert and Raoult, Didier",
  journal  = "Clin. Microbiol. Rev.",
  volume   =  17,
  number   =  2,
  pages    = "413--433",
  abstract = "Free-living amoebae feed on bacteria, fungi, and algae. However,
              some microorganisms have evolved to become resistant to these
              protists. These amoeba-resistant microorganisms include
              established pathogens, such as Cryptococcus neoformans, Legionella
              spp., Chlamydophila pneumoniae, Mycobacterium avium, Listeria
