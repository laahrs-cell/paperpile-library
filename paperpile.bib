@ARTICLE{Dharanishanthi2021-po,
  title     = "Bacterial-induced {pH} shifts link individual cell physiology to
               macroscale collective behavior",
  author    = "Dharanishanthi, Veeramuthu and Orgad, Amit and Rotem, Neta and
