  year     =  2018,
  keywords = "P. aeruginosa; carbamylated protein; cyanate; cyanide; cyanogen
              chloride; cystic fibrosis; hypochlorous acid; ion-specific
              electrode; myeloperoxidase; neutrophils",
  language = "en"
}

@ARTICLE{Ribbe2017-qp,
  title    = "Role of Cyclic Di-{GMP} and Exopolysaccharide in Type {IV} Pilus
