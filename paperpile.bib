  language = "en"
}

@ARTICLE{Yang2021-pl,
  title    = "Identification of Novel {PhoP}-{PhoQ} Regulated Genes That
              Contribute to Polymyxin {B} Tolerance in Pseudomonas aeruginosa",
  author   = "Yang, Baopeng and Liu, Chang and Pan, Xiaolei and Fu, Weixin and
