  month    =  apr,
  year     =  2019,
  language = "en"
}

@ARTICLE{Leys2018-ez,
  title    = "Flavin metamorphosis: cofactor transformation through prenylation",
  author   = "Leys, David",
  journal  = "Curr. Opin. Chem. Biol.",
  volume   =  47,
  pages    = "117--125",
  abstract = "Prenylated flavin (prFMN) is a recently discovered cofactor that
