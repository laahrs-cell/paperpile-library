  language = "en"
}

@ARTICLE{Luirink2012-ua,
  title    = "Biogenesis of inner membrane proteins in Escherichia coli",
  author   = "Luirink, Joen and Yu, Zhong and Wagner, Samuel and de Gier,
              Jan-Willem",
  journal  = "Biochim. Biophys. Acta",
  volume   =  1817,
  number   =  6,
  pages    = "965--976",
  abstract = "The inner membrane proteome of the model organism Escherichia coli
              is composed of inner membrane proteins, lipoproteins and
              peripherally attached soluble proteins. Our knowledge of the
              biogenesis of inner membrane proteins is rapidly increasing. This
              is in particular true for the early steps of biogenesis - protein
              targeting to and insertion into the membrane. However, our
              knowledge of inner membrane protein folding and quality control is
