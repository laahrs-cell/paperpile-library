  year     =  2004,
  keywords = "Animals Bacillus subtilis/cytology/*physiology Cell
              Differentiation Clinical Laboratory Techniques Environment *Nature
              Saccharomyces cerevisiae/*physiology/ultrastructure Signal
              Transduction",
  language = "en"
}

@ARTICLE{Zhang1999-zo,
