@ARTICLE{Fenn2025-ir,
  title     = "{NirA} is a Cyanide-Tolerant Nitrite Reductase Which Protects
               Pseudomonas aeruginosa From Self-Poisoning",
  author    = "Fenn, Samuel and Lambert, Carey and Panagiotopulou, Dimitra and
               Massey, Ruth and Cámara, Miguel",
  journal   = "Environ. Microbiol. Rep.",
  publisher = "Wiley",
  volume    =  17,
  number    =  6,
  pages     = "e70256",
  abstract  = "Host production of nitric oxide in response to P. aeruginosa
               results in accumulation of nitrite and nitrate at the infection
               site, with both utilised for anaerobic respiration to support
               survival. Nitric oxide and nitrite also act as aerobic
               respiratory inhibitors. P. aeruginosa must overcome these toxic
               metabolites alongside self-produced cyanide to persist at the
               infection site. We previously identified a novel nitrite
               reductase (NirA) that supports P. aeruginosa virulence in a wide
               range of infection models. In this work, we demonstrate that
               mutation of nirA inhibits growth of P. aeruginosa at reduced
               oxygen tensions in the presence of nitrite or nitrate, with this
               phenotype shown to be dependent on cyanide. NirA is a
               siroheme-dependent enzyme, a classical target for inhibition with
               cyanide. Biochemical characterisation confirms that NirA is a
               novel cyanide-tolerant nitrite reductase, which supports
               reduction of nitrite in the presence of cyanide. We hypothesise
               that NirA enables detoxification of nitrite to prevent build-up
               of multiple respiratory inhibitors and facilitate
               cyanide-resistant aerobic respiration at low oxygen tensions.
               Through targeting effectors of these resistance mechanisms, we
               could promote P. aeruginosa self-poisoning and prevent adaptation
               to the reduced oxygen environment typically encountered by P.
               aeruginosa in biofilms and during infection.",
  month     =  dec,
  year      =  2025,
  language  = "en"
}

@MISC{Kitts_undated-gf,
  title    = "The Upside Down World of ∆cbrB: Investigating the relationship
              between glycolate and lactate metabolism in the ∆cbrB background
              of Pseudomonas aeruginosa",
  author   = "Kitts, Miracle St and Unterreiner, Lauren and Dietrich, Lars",
  abstract = "Pseudomonas aeruginosa is a gram-negative, opportunistic pathogen
              found in a variety of environments, including soil and water as
              well as in wounds and the lungs of cystic fibrosis (CF) patients
              (1, 2). To survive in such diverse environments, P. aeruginosa has
              developed a hierarchical system of carbon source usage (3). The
              two-component system, involving the proteins CbrA and CbrB, acts
              post-transcriptionally to regulate metabolic pathways (4, 5).
              Abrogating CbrB function results in disruptions to glycolate
              metabolism, affecting the expression of the glcDEFG operon
              encoding a glycolate dehydrogenase (1). Mounting evidence suggests
              there is a high degree of ``cross-talk'' between glycolate
              metabolism and lactate metabolism via the glcDEFG operon and
              lldPDE operon, which is critical for the conversion of lactate
              into pyruvate (1). However, it is not yet understood how this
              relationship is affected by interfering with CbrB function. Here,
              we show lldPDE expression drives glcDEFG expression in the ∆cbrB
              background. Deleting the repressor LldR and thereby overexpressing
              lldPDE in the ∆cbrB background caused an earlier activation of
              glycolate metabolism relative to wild type (WT) and ∆cbrB single
              deletion strains. Furthermore, eliminating lldPDE expression in
              this background caused a significant reduction in glcDEFG
              expression. This results further link glycolate and lactate
              metabolism by demonstrating lldPDE activity influences glcDEFG
              expression, specifically in the ∆cbrB background."
}

@ARTICLE{Parkhill2025-na,
