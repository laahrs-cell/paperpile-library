              between TF, DnaK, GroEL and other molecular chaperones and
              targeting factors, including SecB, SecA, the signal recognition
              particle (SRP) and the redox enzyme maturation proteins (REMPs) is
              also discussed. This article is part of a Special Issue entitled:
              Protein trafficking and secretion in bacteria. Guest Editors:
              Anastassios Economou and Ross Dalbey.",
  month    =  aug,
  year     =  2014,
  keywords = "DnaJ/Hsp40; DnaK/Hsp70; GroEL/Hsp60; Protein targeting pathway;
              SecA–SecB; Trigger Factor",
  language = "en"
}

@ARTICLE{Craney2011-vo,
  title    = "Bacterial transmembrane proteins that lack {N}-terminal signal
              sequences",
  author   = "Craney, Arryn and Tahlan, Kapil and Andrews, David and Nodwell,
              Justin",
  journal  = "PLoS One",
  volume   =  6,
  number   =  5,
  pages    = "e19421",
  abstract = "Tail-anchored membrane proteins (TAMPs), a class of proteins
