@ARTICLE{Sumi2020-es,
  title    = "Light Response of Pseudomonas putida {KT2440} Mediated by Class
              {II} {LitR}, a Photosensor Homolog",
  author   = "Sumi, Satoru and Mutaguchi, Naotaka and Ebuchi, Teppei and
              Tsuchida, Hiroaki and Yamamoto, Takahiro and Suzuki, Maki and
