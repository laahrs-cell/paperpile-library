@ARTICLE{Zhu2018-zu,
  title    = "Universal antibiotic tolerance arising from antibiotic-triggered
              accumulation of redox metabolites",
  author   = "Zhu, Kui and Chen, Shang and Sysoeva, Tatyana A and You, Lingchong",
  journal  = "Cold Spring Harbor Laboratory",
  pages    =  453290,
  abstract = "Abstract Pseudomonas aeruginosa is an opportunistic pathogen that
