@INCOLLECTION{Mohan2018-vc,
  title     = "Quorum Sensing in Microbes and their Function in Modulating
               Antibiotic Synthesis",
  author    = "Mohan, K Varsha and Sahu, Parul",
  editor    = "{Pallaval Veera Bramhachari}",
  booktitle = "Implication of Quorum Sensing System in Biofilm Formation and
