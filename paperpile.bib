}

@ARTICLE{Grosso-Becerra2014-iq,
  title    = "Pseudomonas aeruginosa clinical and environmental isolates
              constitute a single population with high phenotypic diversity",
  author   = "Grosso-Becerra, María-Victoria and Santos-Medellín, Christian and
              González-Valdez, Abigail and Méndez, José-Luis and Delgado,
              Gabriela and Morales-Espinosa, Rosario and Servín-González, Luis
