  keywords = "infectious disease; microbiology",
  language = "en"
}

@ARTICLE{Lawrence2021-vf,
  title    = "A modular toolset for electrogenetics",
  author   = "Lawrence, Joshua M and Yin, Yutong and Bombelli, Paolo and
