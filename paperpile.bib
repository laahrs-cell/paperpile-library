@ARTICLE{Crone2020-ia,
  title    = "The environmental occurrence of Pseudomonas aeruginosa",
  author   = "Crone, Stephanie and Vives-Flórez, Martha and Kvich, Lasse and
              Saunders, Aaron M and Malone, Matthew and Nicolaisen, Mette H and
