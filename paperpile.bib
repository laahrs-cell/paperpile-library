@ARTICLE{Garcia-Bayona2020-jy,
  title    = "Nanaerobic growth enables direct visualization of dynamic cellular
              processes in human gut symbionts",
  author   = "García-Bayona, Leonor and Coyne, Michael J and Hantman, Noam and
