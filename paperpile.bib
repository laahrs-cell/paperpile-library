@ARTICLE{Vergunst2005-rt,
  title    = "Positive charge is an important feature of the {C}-terminal
              transport signal of the {VirB}/{D4}-translocated proteins of
              Agrobacterium",
  author   = "Vergunst, Annette C and van Lier, Miranda C M and den Dulk-Ras,
