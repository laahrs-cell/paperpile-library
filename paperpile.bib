              Stability Protein Structure, Secondary Protein Structure, Tertiary
              Sequence Homology, Amino Acid Viral Envelope
              Proteins/*chemistry/genetics/isolation \& purification/metabolism
              Virus Internalization",
  language = "en"
}

@ARTICLE{Gupta2009-th,
