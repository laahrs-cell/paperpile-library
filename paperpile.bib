  language = "en"
}

@INCOLLECTION{Dayton2020-fy,
  title     = "Sensory Domains That Control Cyclic di-{GMP}-Modulating Proteins:
               A Critical Frontier in Bacterial Signal Transduction",
  author    = "Dayton, Hannah and Smiley, Marina K and Forouhar, Farhad and
